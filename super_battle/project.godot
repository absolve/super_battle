; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="super_battle"
run/main_scene="res://scene/ui/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://autoload/game.gd"
UserData="*res://autoload/user_data.gd"
StageData="*res://autoload/stage_data.gd"
InputManager="*res://autoload/input_manager.gd"
SoundManage="*res://autoload/sound_manage.tscn"
SceneTransition="*res://autoload/scene_transition.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="viewport"

[global_group]

player="玩家"
enemy="敌人"
playerBullet="玩家子弹"
enemyBullet="敌方子弹"
pickup="补给"
spawnPoint="刷怪点"

[internationalization]

locale/translations=PackedStringArray("res://lang/language.en.translation", "res://lang/language.zh.translation")

[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="enemy"
2d_physics/layer_3="playerBullet"
2d_physics/layer_4="enemyBullet"
2d_physics/layer_5="pickup"
2d_physics/layer_6="obstacle"

[physics]

common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07843138, 0.10196079, 0.14509805, 1)
